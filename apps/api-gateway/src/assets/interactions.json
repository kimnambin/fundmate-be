{
  "openapi": "3.0.4",
  "info": {
    "title": "Interaction Service API",
    "version": "1.0.0",
    "description": "사용자 간의 상호작용(프로젝트 좋아요/찜, 후기/댓글 관리) 기능을 제공하는 마이크로서비스입니다. 사용자의 관심사를 파악하고 개인화된 경험을 제공하는 데 활용됩니다."
  },
  "servers": [
    {
      "url": "https://fundmate.store/api",
      "description": "API 게이트웨이"
    }
  ],
  "tags": [
    {
      "name": "좋아요/찜 (Likes)",
      "description": "프로젝트에 대한 사용자의 좋아요/찜 등록, 취소 및 목록 조회 API"
    },
    {
      "name": "후기/댓글 (Comments)",
      "description": "프로젝트에 대한 사용자 후기/댓글 작성, 조회 및 삭제 API"
    }
  ],
  "paths": {
    "/users/likes": {
      "get": {
        "tags": [
          "좋아요/찜 (Likes)"
        ],
        "summary": "내가 좋아요한 프로젝트 목록",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "페이지 번호"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 100
            },
            "description": "페이지 크기(최대 100)"
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공(배열)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LikedProject"
                  }
                },
                "examples": {
                  "sample": {
                    "value": [
                      {
                        "project_id": 1,
                        "title": "프로젝트",
                        "img_url": "https://.../a.png",
                        "current_amount": 1000,
                        "goal_amount": 100000,
                        "description": "설명"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/users/likes/{id}": {
      "post": {
        "tags": [
          "좋아요/찜 (Likes)"
        ],
        "summary": "프로젝트 좋아요 추가",
        "description": "이미 좋아요한 프로젝트여도 200입니다(멱등).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/projectId"
          }
        ],
        "responses": {
          "200": {
            "description": "추가 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "좋아요가 추가되었습니다."
                    }
                  }
                },
                "examples": {
                  "sample": {
                    "value": {
                      "message": "좋아요가 추가되었습니다."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "프로젝트를 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "프로젝트를 찾을 수 없습니다."
                    }
                  }
                },
                "examples": {
                  "sample": {
                    "value": {
                      "message": "프로젝트를 찾을 수 없습니다."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "delete": {
        "tags": [
          "좋아요/찜 (Likes)"
        ],
        "summary": "프로젝트 좋아요 취소",
        "description": "좋아요하지 않은 프로젝트여도 200입니다(멱등).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/projectId"
          }
        ],
        "responses": {
          "200": {
            "description": "취소 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "좋아요가 제거되었습니다."
                    }
                  }
                },
                "examples": {
                  "sample": {
                    "value": {
                      "message": "좋아요가 제거되었습니다."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/comment/{id}": {
      "get": {
        "tags": [
          "후기/댓글 (Comments)"
        ],
        "summary": "프로젝트의 댓글 목록",
        "description": "id는 프로젝트 ID입니다. 최신순이며 페이지당 최대 100개입니다.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/projectId"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "페이지 번호"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 100
            },
            "description": "페이지 크기(최대 100)"
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공(배열)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Comment"
                  }
                },
                "examples": {
                  "sample": {
                    "value": [
                      {
                        "commentId": 1,
                        "userId": 1,
                        "nickname": "alice",
                        "imgId": 7,
                        "content": "좋은 프로젝트네요",
                        "createdAt": "2026-01-01T00:00:00.000Z"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "post": {
        "tags": [
          "후기/댓글 (Comments)"
        ],
        "summary": "댓글 작성",
        "description": "id는 프로젝트 ID입니다.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/projectId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommentCreateRequest"
              },
              "examples": {
                "sample": {
                  "value": {
                    "contents": "좋은 프로젝트네요"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "작성 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommentCreated"
                },
                "examples": {
                  "sample": {
                    "value": {
                      "commentId": 1,
                      "content": "좋은 프로젝트네요",
                      "createdAt": "2026-01-01T00:00:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "프로젝트를 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "프로젝트를 찾을 수 없습니다."
                    }
                  }
                },
                "examples": {
                  "sample": {
                    "value": {
                      "message": "프로젝트를 찾을 수 없습니다."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "delete": {
        "tags": [
          "후기/댓글 (Comments)"
        ],
        "summary": "댓글 삭제",
        "description": "id는 댓글 ID입니다. 작성자 본인만 삭제할 수 있습니다.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "댓글 ID",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "삭제 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "댓글이 삭제되었습니다."
                    }
                  }
                },
                "examples": {
                  "sample": {
                    "value": {
                      "message": "댓글이 삭제되었습니다."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "description": "내 댓글이 아님",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "댓글 삭제 권한이 없습니다."
                    }
                  }
                },
                "examples": {
                  "sample": {
                    "value": {
                      "message": "댓글 삭제 권한이 없습니다."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "댓글을 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "댓글을 찾을 수 없습니다."
                    }
                  }
                },
                "examples": {
                  "sample": {
                    "value": {
                      "message": "댓글을 찾을 수 없습니다."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/interactionmain": {
      "get": {
        "tags": [
          "좋아요/찜 (Likes)"
        ],
        "summary": "내 좋아요/댓글 개수",
        "description": "마이페이지(user-service)가 호출합니다.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "likeCount": {
                      "type": "integer"
                    },
                    "commentCount": {
                      "type": "integer"
                    }
                  }
                },
                "examples": {
                  "sample": {
                    "value": {
                      "likeCount": 3,
                      "commentCount": 5
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "$ref": "./auths.json#/components/securitySchemes/bearerAuth"
      }
    },
    "parameters": {
      "projectId": {
        "name": "id",
        "in": "path",
        "description": "프로젝트 고유 ID(양의 정수)",
        "required": true,
        "schema": {
          "type": "integer",
          "example": 123
        }
      }
    },
    "schemas": {
      "LikedProject": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "img_url": {
            "type": "string",
            "nullable": true
          },
          "current_amount": {
            "type": "integer"
          },
          "goal_amount": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "commentId": {
            "type": "integer"
          },
          "userId": {
            "type": "integer"
          },
          "nickname": {
            "type": "string"
          },
          "imgId": {
            "type": "integer",
            "nullable": true,
            "description": "작성자 프로필 이미지 ID"
          },
          "content": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CommentCreateRequest": {
        "type": "object",
        "required": [
          "contents"
        ],
        "properties": {
          "contents": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "댓글 내용(공백 제거 후 1~500자). content 필드도 허용"
          }
        }
      },
      "CommentCreated": {
        "type": "object",
        "properties": {
          "commentId": {
            "type": "integer"
          },
          "content": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorResponse": {
        "$ref": "./auths.json#/components/schemas/ErrorResponse"
      }
    },
    "responses": {
      "BadRequest": {
        "$ref": "./auths.json#/components/responses/BadRequest"
      },
      "Unauthorized": {
        "$ref": "./auths.json#/components/responses/Unauthorized"
      },
      "InternalError": {
        "$ref": "./auths.json#/components/responses/InternalError"
      }
    }
  }
}
