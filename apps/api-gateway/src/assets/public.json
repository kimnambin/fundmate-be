{
  "openapi": "3.0.4",
  "info": {
    "title": "Public Service API",
    "version": "1.0.0",
    "description": "통계청 SGIS OpenAPI의 연도별(2019~2023) 인구·가구·주택 통계를 조회합니다. 로그인이 필요 없으며, 결과는 서버에서 24시간 캐시됩니다."
  },
  "servers": [
    {
      "url": "https://fundmate.store/api",
      "description": "공공데이터 서버"
    }
  ],
  "tags": [
    {
      "name": "공개 데이터 조회 (Public Data Retrieval)",
      "description": "SGIS 통계 조회 API"
    }
  ],
  "paths": {
    "/datas/option": {
      "post": {
        "tags": [
          "공개 데이터 조회 (Public Data Retrieval)"
        ],
        "summary": "연령대/성별/지역별 인구 통계 조회",
        "description": "연령대, 성별, 지역 조건의 인구 통계를 연도별(2019~2023)로 조회합니다. 값은 SGIS 코드를 그대로 사용합니다. 응답은 서버에서 24시간 캐시됩니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OptionDataRequest"
              },
              "examples": {
                "sample": {
                  "summary": "20대 여성, 서울",
                  "value": {
                    "age_group": 32,
                    "gender": 2,
                    "area": 11
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/YearResult"
                  }
                },
                "examples": {
                  "sample": {
                    "summary": "응답 예시",
                    "value": [
                      {
                        "year": 2019,
                        "result": [
                          {
                            "adm_cd": "11",
                            "population": "1234567"
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/datas/keyword": {
      "post": {
        "tags": [
          "공개 데이터 조회 (Public Data Retrieval)"
        ],
        "summary": "인구/가구/주택 통계 조회",
        "description": "선택한 항목(people, household, house)의 전국 통계를 연도별로 조회합니다. 하나 이상을 true로 보내야 하며, 보내지 않은 항목은 선택하지 않은 것으로 봅니다. 응답에는 선택한 항목만 포함됩니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KeywordDataRequest"
              },
              "examples": {
                "sample": {
                  "summary": "인구와 가구 선택",
                  "value": {
                    "people": true,
                    "household": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeywordDataResponse"
                },
                "examples": {
                  "sample": {
                    "summary": "응답 예시",
                    "value": {
                      "people": [
                        {
                          "year": 2019,
                          "result": [
                            {}
                          ]
                        }
                      ],
                      "household": [
                        {
                          "year": 2019,
                          "result": [
                            {}
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OptionDataRequest": {
        "type": "object",
        "title": "옵션 데이터 요청",
        "required": [
          "age_group",
          "gender"
        ],
        "properties": {
          "age_group": {
            "type": "integer",
            "example": 32,
            "description": "SGIS 연령대 코드(age_type). 숫자 문자열도 허용"
          },
          "gender": {
            "type": "integer",
            "enum": [
              0,
              1,
              2
            ],
            "example": 2,
            "description": "SGIS 성별 코드. 0 전체, 1 남자, 2 여자"
          },
          "area": {
            "type": "integer",
            "example": 11,
            "description": "SGIS 행정구역 코드(adm_cd). 생략하거나 0이면 전국"
          }
        }
      },
      "KeywordDataRequest": {
        "type": "object",
        "title": "키워드 데이터 요청",
        "description": "하나 이상 true여야 합니다.",
        "properties": {
          "people": {
            "type": "boolean",
            "example": true
          },
          "household": {
            "type": "boolean",
            "example": false
          },
          "house": {
            "type": "boolean",
            "example": false
          }
        }
      },
      "YearResult": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "example": 2023
          },
          "result": {
            "description": "SGIS 응답의 result. 결과가 없으면 빈 배열",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "KeywordDataResponse": {
        "type": "object",
        "properties": {
          "people": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/YearResult"
            }
          },
          "household": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/YearResult"
            }
          },
          "house": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/YearResult"
            }
          }
        }
      },
      "ErrorResponse": {
        "$ref": "./auths.json#/components/schemas/ErrorResponse"
      }
    },
    "responses": {
      "BadRequest": {
        "$ref": "./auths.json#/components/responses/BadRequest"
      },
      "InternalError": {
        "$ref": "./auths.json#/components/responses/InternalError"
      }
    }
  }
}
