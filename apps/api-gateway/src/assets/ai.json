{
  "openapi": "3.0.4",
  "info": {
    "title": "AI Service API",
    "version": "1.0.0",
    "description": "아이디어 요약과 확장을 Groq LLM으로 처리합니다. 로그인한 사용자만 사용할 수 있고, 사용자별 호출 횟수가 제한됩니다."
  },
  "servers": [
    {
      "url": "https://fundmate.store/api",
      "description": "API 게이트웨이"
    }
  ],
  "tags": [
    {
      "name": "AI 아이디어 도우미 (AI)",
      "description": "프로젝트 아이디어 요약/확장 API"
    }
  ],
  "paths": {
    "/ai/summarize": {
      "post": {
        "tags": [
          "AI 아이디어 도우미 (AI)"
        ],
        "summary": "아이디어 40자 요약",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "message는 1~1,000자 문자열입니다. 사용자당 분당 5회(AI_RATE_PER_MIN), 하루 100회(AI_DAILY_LIMIT)로 제한됩니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                }
              },
              "examples": {
                "sample": {
                  "value": {
                    "message": "반려동물 자동 급식기를 만들어 후원받고 싶습니다."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "요약 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "summary": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "sample": {
                    "value": {
                      "summary": "반려동물 자동 급식기 후원 프로젝트입니다."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "입력이 올바르지 않음",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "메시지을(를) 입력해 주세요."
                    },
                    "error": {
                      "type": "string",
                      "example": "메시지을(를) 입력해 주세요.",
                      "description": "message와 같은 값(기존 클라이언트 호환)"
                    }
                  }
                },
                "examples": {
                  "sample": {
                    "value": {
                      "message": "메시지을(를) 입력해 주세요.",
                      "error": "메시지을(를) 입력해 주세요."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "로그인 필요",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "로그인이 필요합니다."
                    },
                    "error": {
                      "type": "string",
                      "example": "로그인이 필요합니다.",
                      "description": "message와 같은 값(기존 클라이언트 호환)"
                    }
                  }
                },
                "examples": {
                  "sample": {
                    "value": {
                      "message": "로그인이 필요합니다.",
                      "error": "로그인이 필요합니다."
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "호출 한도 초과",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "요청이 너무 많습니다. 잠시 후 다시 시도해 주세요."
                    },
                    "error": {
                      "type": "string",
                      "example": "요청이 너무 많습니다. 잠시 후 다시 시도해 주세요.",
                      "description": "message와 같은 값(기존 클라이언트 호환)"
                    }
                  }
                },
                "examples": {
                  "sample": {
                    "value": {
                      "message": "요청이 너무 많습니다. 잠시 후 다시 시도해 주세요.",
                      "error": "요청이 너무 많습니다. 잠시 후 다시 시도해 주세요."
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "AI 서비스 호출 실패",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "AI 서비스 호출에 실패했습니다."
                    },
                    "error": {
                      "type": "string",
                      "example": "AI 서비스 호출에 실패했습니다.",
                      "description": "message와 같은 값(기존 클라이언트 호환)"
                    }
                  }
                },
                "examples": {
                  "sample": {
                    "value": {
                      "message": "AI 서비스 호출에 실패했습니다.",
                      "error": "AI 서비스 호출에 실패했습니다."
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "AI 서비스 설정 없음",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "AI 서비스를 사용할 수 없습니다."
                    },
                    "error": {
                      "type": "string",
                      "example": "AI 서비스를 사용할 수 없습니다.",
                      "description": "message와 같은 값(기존 클라이언트 호환)"
                    }
                  }
                },
                "examples": {
                  "sample": {
                    "value": {
                      "message": "AI 서비스를 사용할 수 없습니다.",
                      "error": "AI 서비스를 사용할 수 없습니다."
                    }
                  }
                }
              }
            }
          },
          "504": {
            "description": "AI 응답 지연(20초)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "AI 응답이 지연되고 있습니다. 잠시 후 다시 시도해 주세요."
                    },
                    "error": {
                      "type": "string",
                      "example": "AI 응답이 지연되고 있습니다. 잠시 후 다시 시도해 주세요.",
                      "description": "message와 같은 값(기존 클라이언트 호환)"
                    }
                  }
                },
                "examples": {
                  "sample": {
                    "value": {
                      "message": "AI 응답이 지연되고 있습니다. 잠시 후 다시 시도해 주세요.",
                      "error": "AI 응답이 지연되고 있습니다. 잠시 후 다시 시도해 주세요."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ai/requests": {
      "post": {
        "tags": [
          "AI 아이디어 도우미 (AI)"
        ],
        "summary": "아이디어 확장(마크다운 기획서)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "input_text는 1~1,000자, category / gender / age_ground는 한 줄 30자 이하 문자열입니다. (필드 이름은 age_ground 그대로)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input_text",
                  "category",
                  "gender",
                  "age_ground"
                ],
                "properties": {
                  "input_text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "category": {
                    "type": "string",
                    "maxLength": 30,
                    "example": "테크"
                  },
                  "gender": {
                    "type": "string",
                    "maxLength": 30,
                    "example": "관계없음"
                  },
                  "age_ground": {
                    "type": "string",
                    "maxLength": 30,
                    "example": "20대"
                  }
                }
              },
              "examples": {
                "sample": {
                  "value": {
                    "input_text": "반려동물 자동 급식기",
                    "category": "테크",
                    "gender": "관계없음",
                    "age_ground": "20대"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "확장 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "expanded_Idea": {
                      "type": "string",
                      "description": "마크다운"
                    }
                  }
                },
                "examples": {
                  "sample": {
                    "value": {
                      "expanded_Idea": "# 🐶 20대 관계없음을 위한 펀딩 아이디어 ..."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "입력이 올바르지 않음",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "아이디어을(를) 입력해 주세요."
                    },
                    "error": {
                      "type": "string",
                      "example": "아이디어을(를) 입력해 주세요.",
                      "description": "message와 같은 값(기존 클라이언트 호환)"
                    }
