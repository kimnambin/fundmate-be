{
  "openapi": "3.0.4",
  "info": {
    "title": "Fundings Service API",
    "version": "1.0.0",
    "description": "펀딩 프로젝트 생성/상세, 메인 화면 목록, 옵션 삭제, 프로필 펀딩 목록을 제공합니다. 프로젝트 진행 상태는 저장된 값이 아니라 시작일/종료일로 계산합니다."
  },
  "servers": [
    {
      "url": "https://fundmate.store/api",
      "description": "API 게이트웨이"
    }
  ],
  "tags": [
    {
      "name": "프로젝트/옵션 (Project & Options)",
      "description": "프로젝트 생성/상세, 옵션 삭제"
    },
    {
      "name": "메인 목록 (Projects)",
      "description": "메인 화면 프로젝트 목록. 기본은 종료되지 않은 프로젝트(status=open)입니다."
    },
    {
      "name": "프로필 펀딩 목록 (Profiles)",
      "description": "내 펀딩/후기, 다른 회원의 펀딩 목록"
    }
  ],
  "paths": {
    "/projects": {
      "post": {
        "tags": [
          "프로젝트/옵션 (Project & Options)"
        ],
        "summary": "새 펀딩 프로젝트 생성",
        "description": "프로젝트와 옵션을 한 트랜잭션으로 저장합니다. 시작일은 오늘 이후, 시작일 ≤ 종료일 ≤ 배송일이어야 하고 이미지는 업로드 API로 받은 주소만 허용합니다.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectCreateRequest"
              },
              "examples": {
                "sample": {
                  "value": {
                    "image_url": "https://bucket.s3.ap-northeast-2.amazonaws.com/uploads/1/1700000000000-uuid.png",
                    "title": "친환경 텀블러",
                    "short_description": "매일 쓰는 텀블러",
                    "description": "상세 소개",
                    "goal_amount": 5000000,
                    "start_date": "2026-10-01",
                    "end_date": "2026-11-01",
                    "delivery_date": "2026-12-01",
                    "category_id": 3,
                    "gender": 0,
                    "age_group": 0,
                    "options": [
                      {
                        "title": "텀블러 1개",
                        "description": "기본 구성",
                        "price": 25000
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "생성 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "project_id": {
                      "type": "integer"
                    }
                  }
                },
                "examples": {
                  "sample": {
                    "value": {
                      "project_id": 12
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/projects/{project_id}": {
      "get": {
        "tags": [
          "프로젝트/옵션 (Project & Options)"
        ],
        "summary": "프로젝트 상세 조회",
        "description": "로그인 여부는 선택입니다. 로그인하면 liked(내가 좋아요했는지)가 계산됩니다. sponsor는 후원한 사용자 수입니다.",
        "parameters": [
          {
            "$ref": "#/components/parameters/projectId"
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectDetail"
                },
                "examples": {
                  "sample": {
                    "value": {
                      "project": {
                        "project_id": 1,
                        "image_url": "https://.../a.png",
                        "title": "프로젝트",
                        "current_price": 250000,
                        "remaining_day": 12,
                        "goal_amount": 1000000,
                        "start_date": "2026-10-01",
                        "end_date": "2026-11-01",
                        "delivery_date": "2026-12-01",
                        "description": "소개",
                        "payment_date": "2026-11-02",
                        "sponsor": 5,
                        "likes": 3,
                        "liked": false
                      },
                      "users": {
                        "image_id": 2,
                        "nickname": "maker",
                        "content": "소개"
                      },
                      "options": [
                        {
                          "title": "옵션",
                          "description": "설명",
                          "price": 25000
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/options/{option_id}": {
      "delete": {
        "tags": [
          "프로젝트/옵션 (Project & Options)"
        ],
        "summary": "옵션 삭제",
        "description": "내 프로젝트의 옵션만 삭제할 수 있습니다. 프로젝트가 이미 시작되었거나 후원에 쓰인 옵션은 409입니다.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/optionId"
          }
        ],
        "responses": {
          "200": {
            "description": "삭제 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "옵션이 삭제되었습니다."
                    }
                  }
                },
                "examples": {
                  "sample": {
                    "value": {
                      "message": "옵션이 삭제되었습니다."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "삭제할 수 없는 옵션",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "후원에 사용된 옵션은 삭제할 수 없습니다."
                    }
                  }
                },
                "examples": {
                  "sample": {
                    "value": {
                      "message": "후원에 사용된 옵션은 삭제할 수 없습니다."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/projects": {
      "get": {
        "tags": [
          "메인 목록 (Projects)"
        ],
        "summary": "전체 프로젝트 목록 (메인)",
        "description": "최신순. 기본은 종료되지 않은 프로젝트입니다.",
        "parameters": [
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/page"
          },
          {
            "$ref": "#/components/parameters/status"
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공(배열)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProjectListItem"
                  }
                },
                "examples": {
                  "sample": {
                    "value": [
                      {
                        "project_id": 1,
                        "image_url": "https://.../a.png",
                        "title": "프로젝트",
                        "short_description": "한 줄 설명",
                        "goal_amount": 1000000,
                        "current_amount": 250000,
                        "achievement": 25,
                        "remaining_day": 12
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/projects/recent": {
      "get": {
        "tags": [
          "메인 목록 (Projects)"
        ],
        "summary": "최근 본 프로젝트 목록",
        "description": "project_id를 반복하거나 쉼표로 구분해 보냅니다(최대 20개). 보낸 순서대로 반환하고, 숫자가 아닌 값은 무시합니다. (이 응답만 camelCase 키)",
        "parameters": [
          {
            "name": "project_id",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "style": "form",
            "explode": true,
            "description": "예: project_id=3&project_id=1 또는 project_id=3,1"
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공(배열)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RecentProject"
                  }
                },
                "examples": {
                  "sample": {
                    "value": [
                      {
                        "project_id": 1,
                        "imageUrl": "https://.../a.png",
                        "title": "프로젝트",
                        "shortDescription": "설명",
                        "goalAmount": 1000000,
                        "currentAmount": 250000,
                        "achievement": 25,
                        "remainingDay": 12
                      }
                    ]
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
